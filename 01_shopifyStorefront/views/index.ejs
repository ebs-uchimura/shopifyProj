<!DOCTYPE html>
<html lang="ja">

<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# website: http://ogp.me/ns/website#">
  <meta charset="UTF-8">
  <title>Compassギフトサイト</title>
  <meta content="compass" name="description">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="description" content="このたび、名入れギフトの専門店「Giftshop Compass（ギフトショップ コンパス）」は、公式オンラインストアをグランドオープンいたしました。“想いを形に”をコンセプトに、受け取った瞬間に心に残る、上質で洗練された贈り物をご提案いたします。">
  <meta name="keywords" content="ギフト,酒,タンブラー,ワイン,グラス">
  <meta property="og:url" content="https://compass-linq.com">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Compassギフトサイト">
  <meta property="og:description" content="このたび、名入れギフトの専門店「Giftshop Compass（ギフトショップ コンパス）」は、公式オンラインストアをグランドオープンいたしました。“想いを形に”をコンセプトに、受け取った瞬間に心に残る、上質で洗練された贈り物をご提案いたします。">
  <meta property="og:site_name" content="Compassギフトサイト">
  <meta property="og:imagecategory/category5.jpg" content="/images/icon/apple-touch-icon.png">
  <meta name="twitter:card" content="summary">
  <meta name="format-detection" content="telephone=no">
  <link rel="canonical" href="https://ec.compass-linq.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="apple-touch-icon" sizes="180x180" href="/images/icon/apple-touch-icon.png">
  <link rel="shortcut icon" href="/images/favicon.ico">
  <link rel="icon" type="image/png" href="/images/icon/android-touch-icon.png" sizes="192x192">
  <link rel="stylesheet" href="https://unpkg.com/ress@4.0.0/dist/ress.min.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/button.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Modaal/0.4.4/css/modaal.min.css">
  <link rel="stylesheet" href="https://unpkg.com/flickity@2.3.0/dist/flickity.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/lazyload@2.0.0-rc.2/lazyload.min.js"></script>
  <script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Modaal/0.4.4/js/modaal.min.js"></script>
  <script>
    $(function () {
      getGlobalRoot("<%= root %>");
      $("img.lazyload").lazyload();
      $(".searchbutton").modaal({
        content_source: "#inline"
      });
      $(".js-flickity").flickity({
        // options
        cellAlign: "left",
        contain: true
      });
    });
  </script>
  <script src="/js/index.js"></script>
</head>
<body>
  <main>
    <%- include("./partials/header.ejs") %>
    <% if (topimg) { %>
    <div class="gallery js-flickity" data-flickity-options="{ "autoPlay": true }">
      <div class="gallery-cell">
        <% if (topimg[0]) { %>
          <img class="header-image" src="/images/top/<%= topimg[0].topimgurl %>" alt="">
        <% } %>
      </div>
      <div class="gallery-cell">
        <% if (topimg[1]) { %>
          <img class="header-image" src="/images/top/<%= topimg[1].topimgurl %>" alt="">
        <% } %>
      </div>
      <div class="gallery-cell">
        <% if (topimg[2]) { %>
          <img class="header-image" src="/images/top/<%= topimg[2].topimgurl %>" alt="">
        <% } %>
      </div>
    </div>
    <% } %>
    <div class="img-txt">想いを形にする、世界に一つだけの名入れギフト。</div>
    <div class="wrap main-recommend-wrapper">
      <h3 class="headline-standard libre-baskerville">
        RECOMMENDATION
        <span class="headline-small noto-sans">&thinsp;おすすめ商品</span>
      </h3>
      <div class="product-row-wrapper">
        <div id="recommendarea" class="product-row-parent">
          <% if (recommend.length> 0) { %>
          <% recommend.forEach(function(rec) { %>
          <div class="product-row-child">
            <ul class="product-flex">
              <li class="list-image">
                <div class="favbutton">
                  <i class="hearton heartbutton fa-solid fa-heart display-none" value="">
                    <span>
                      <%= rec.id %>
                    </span>
                  </i>
                  <i class="heartoff heartbutton fa-regular fa-heart" value="">
                    <span>
                      <%= rec.id %>
                    </span>
                  </i>
                </div>
                <a href="/product/<%= rec.id %>">
                  <img class="recommend1 lazyload" data-src="<%= rec.imagepath1 %>" alt="<%= rec.productname %>"
                    onerror="this.onerror = null; this.src='';">
                </a>
              </li>
              <li class="list-title">
                <%= rec.productname %>
              </li>
              <li class="list-content">
                <p>
                  <%= rec.description %>
                </p>
              </li>
            </ul>
          </div>
          <% }) %>
          <% } %>
        </div>
      </div>
    </div>
    <div class="wrap main-new-wrapper">
      <h3 class="headline-standard libre-baskerville">
        NEW
        <span class="noto-sans headline-small">&thinsp;新商品</span>
      </h3>
      <div class="product-row-wrapper">
        <div id="latestdata" class="product-row-parent">
          <% if (latest.length> 0) { %>
          <% latest.forEach(function(lt) { %>
          <div class="product-row-child">
            <ul class="product-flex">
              <li class="list-image">
                <div class="favbutton">
                  <i class="hearton heartbutton fa-solid fa-heart display-none" value="">
                    <span>
                      <%= lt.id %>
                    </span>
                  </i>
                  <i class="heartoff heartbutton fa-regular fa-heart" value="">
                    <span>
                      <%= lt.id %>
                    </span>
                  </i>
                </div>
                <a href="/product/<%= lt.id %>">
                  <img class="recommend1 lazyload" data-src="<%= lt.imagepath1 %>" alt="<%= lt.productname %>"
                    onerror="this.onerror = null; this.src='';">
                </a>
              </li>
              <li class="list-title">
                <%= lt.productname %>
              </li>
              <li class="list-content">
                <p>
                  <%= lt.description %>
                </p>
              </li>
            </ul>
          </div>
          <% }) %>
          <% } %>
        </div>
      </div>
    </div>
    <div class="main-ranking-wrapper">
      <h3 class="headline-standard libre-baskerville">
        RANKING
        <span class="noto-sans headline-small">&thinsp;ランキング</span>
      </h3>
      <div class="ranking-row-wrapper">
        <ul id="rankingarea" class="ranking-row-parent">
        <% if (ranking.length> 0) { %>
        <% ranking.forEach(function(rk) { %>
          <li class="ranking-row-child">
            <a href="/product/<%= rk.id %>">
              <img class="recommend1 lazyload" data-src="<%= rk.imagepath1 %>" alt="<%= rk.productname %>"
                onerror="this.onerror = null; this.src='';">
            </a>
          </li>
          <% }) %>
          <% } %>
        </ul>
      </div>
    </div>
    <div class="main-news-wrapper">
      <div class="main-article-wrapper">
        <h3 class="news-standard libre-baskerville">
          NEWS
          <span class="noto-sans headline-small">&thinsp;新着記事</span>
        </h3>
        <div class="main-article-content">
        <% if (news.length> 0) { %>
        <% news.forEach(function(nw) { %>
        <ul class="news-flex">
          <li class="list-image">
            <a href="/news/<%= nw.id %>"><img class="new1 lazyload" src="/images/news/<%= nw.imageurl %>" class="lazyload" alt=""></a>
          </li>
          <li class="list-title">
            <p>
              <a href="/news/<%= nw.id %>"><%= nw.title %></a>
            </p>
          </li>
          <li class="list-content three-trimming">
            <a href="/news/<%= nw.id %>"><%= nw.context %></a>
          </li>
          <li class="list-date">
            <a href="/news/<%= nw.id %>"><%= nw.date %></a>
          </li>
        </ul>
        <% }) %>
        <% } %>
        <% if (news.length> 4) { %>
          <div class="list-seemore">
            <a href="" class="btn">もっと見る</a>
          </div>
          <% } %>
        </div>
      </div>
      <div class="main-sub-wrapper">
        <div class="main-category-wrapper">
          <h3 class="headline-side libre-baskerville">
            CATEGORY<br class="forpc">
            <span class="noto-sans headline-small">&thinsp;カテゴリ</span>
          </h3>
          <ul>
            <% if (allcategories.length> 0) { %>
            <% allcategories.forEach(function(cat) { %>
            <li>
              <a href="/category/<%= cat.id %>" class="btn">
                <%= cat.categoryname %>
              </a>
            </li>
            <% }) %>
            <% } %>
          </ul>
        </div>
      </div>
    </div>
    <div class="main-appeal-wrapper">
      <img class="appeal lazyload" data-src="/images/banner/appeal1.jpg" data-srcset="
        /images/banner/appeal/appeal1.jpg 1x, 
        /images/news/appeal/appeal1@2x.jpg 2x,
        /images/news/appeal/appeal1@3x.jpg 3x,
        " class="lazyload" alt="">
      <img class="appeal lazyload" data-src="/images/banner/appeal2.jpg" data-srcset="
        /images/banner/appeal/appeal2.jpg 1x, 
        /images/news/appeal/appeal2@2x.jpg 2x,
        /images/news/appeal/appeal2@3x.jpg 3x,
      " class="lazyload" alt="">
    </div>
    <hr>
    <div class="main-introduction-wrapper">
      <% if (allcategories.length> 0) { %>
      <% allcategories.forEach(function(cate, idx) { %>
      <% var direction=idx % 2==0 ? "right" : "left" ; %>
      <div class="main-genre-wrapper <%= direction %>">
        <div class="main-genre-img-wrapper">
          <img class="appeal lazyload" src="/images/category/<%= cate.imagepath %>" class="lazyload" alt="">
        </div>
        <div class="main-genre-content-wrapper">
          <h4 class="">
            <span class="header">
              <%= cate.englishname %>
            </span>
            <br>
            <%= cate.categoryname %>
          </h4>
          <p>
            <%= cate.context %>
          </p>
          <a href="/category/<%= cate.id %>" class="btn">もっと見る</a>
        </div>
      </div>
      <% }) %>
      <% } %>
    </div>
    <script src="/js/common/convert.js"></script>
  </main>
  <%- include("./partials/footer.ejs") %>
</body>
</html>