<!DOCTYPE html>
<html lang="ja">

<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# website: http://ogp.me/ns/website#">
  <meta charset="UTF-8">
  <title>Compassギフトサイト商品詳細</title>
  <meta content="compass" name="description">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="description" content="このたび、名入れギフトの専門店「Giftshop Compass（ギフトショップ コンパス）」は、公式オンラインストアをグランドオープンいたしました。“想いを形に”をコンセプトに、受け取った瞬間に心に残る、上質で洗練された贈り物をご提案いたします。">
  <meta name="keywords" content="ギフト,酒,タンブラー,ワイン,グラス">
  <meta property="og:url" content="https://compass-linq.com">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Compassギフトサイト">
  <meta property="og:description" content="このたび、名入れギフトの専門店「Giftshop Compass（ギフトショップ コンパス）」は、公式オンラインストアをグランドオープンいたしました。“想いを形に”をコンセプトに、受け取った瞬間に心に残る、上質で洗練された贈り物をご提案いたします。">
  <meta property="og:site_name" content="LINQUEST">
  <meta property="og:image" content="/imgages/apple-touch-icon.png">
  <meta name="twitter:card" content="summary">
  <meta name="format-detection" content="telephone=no">
  <link rel="canonical" href="https://compass-linq.com/tokusho">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="apple-touch-icon" sizes="180x180" href="/imgages/apple-touch-icon.png">
  <link rel="shortcut icon" href="/images/favicon.ico">
  <link rel="icon" type="image/png" href="/imgages/android-touch-icon.png" sizes="192x192">
  <link rel="stylesheet" href="https://unpkg.com/ress@4.0.0/dist/ress.min.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/custom.css">
  <link rel="stylesheet" href="/css/detail.css">
  <link rel="stylesheet" href="/css/button.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Modaal/0.4.4/css/modaal.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css">
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/lazyload@2.0.0-rc.2/lazyload.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Modaal/0.4.4/js/modaal.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/validation/detailvalidation.js"></script>
  <script>
    $(function () {
      getGlobalFlgs("<%= myproduct.bottleprinting %>", "<%= myproduct.glassprinting %>");
      $("img.lazyload").lazyload();
      $(".searchbutton").modaal({
        content_source: "#inline"
      });
      $("#review-button").modaal({
        content_source: "#reviewbox"
      });
      var splide = new Splide(".splide");
      splide.mount();
    });
  </script>
  <script src="/js/index.js"></script>
</head>

<body>
  <main>
    <%- include("./partials/header.ejs") %>
    <div class="main-breadcrumb-wrapper">
      <nav>
        <ol class="breadcrumb">
          <li><a href="/">TOP</a></li>
          <li><a href="/category/<%= myproduct.category_id %>"><%= myproduct.categoryname %></a></li>
          <li><a href="/product/<%= myproduct.id %>"><%= myproduct.productname %></a></li>
        </ol>
      </nav>
    </div>
    <div class="wrap detail-main-wrapper">
      <section class="detail-main-img splide" aria-label="Splideの基本的なHTML">
        <div class="splide__track">
          <ul class="splide__list">
            <li class="splide__slide">
              <img class="detailimg" src="<%= myproduct.imagepath1 %>" alt="<%= myproduct.productname %>" onerror="this.onerror = null; this.src='';">
            </li>
            <% if (myproduct.imagepath2) { %>
            <li class="splide__slide">
              <img class="detailimg" src="<%= myproduct.imagepath2 %>" alt="<%= myproduct.productname %>"  onerror="this.onerror = null; this.src='';">
            </li>
            <% } %>
            <% if (myproduct.imagepath3) { %>
            <li class="splide__slide">
              <img class="detailimg" src="<%= myproduct.imagepath3 %>" alt="<%= myproduct.productname %>"  onerror="this.onerror = null; this.src='';">
            </li>
            <% } %>
            <% if (myproduct.imagepath4) { %>
            <li class="splide__slide">
              <img class="detailimg" src="<%= myproduct.imagepath4 %>" alt="<%= myproduct.productname %>"  onerror="this.onerror = null; this.src='';">
            </li>
            <% } %>
            <% if (myproduct.imagepath5) { %>
            <li class="splide__slide">
              <img class="detailimg" src="<%= myproduct.imagepath5 %>" alt="<%= myproduct.productname %>"  onerror="this.onerror = null; this.src='';">
            </li>
            <% } %>
            <% if (myproduct.imagepath6) { %>
            <li class="splide__slide">
              <img class="detailimg" src="<%= myproduct.imagepath6 %>" alt="<%= myproduct.productname %>"  onerror="this.onerror = null; this.src='';">
            </li>
            <% } %>
          </ul>
        </div>
      </section>
      <div class="wrap information-main-wrapper">
        <ul class="detail-flex">
          <li class="detail-list-title">
            <%= myproduct.productname %>
          </li>
          <li class="detail-list-review">
            <div class="ratebox">
              <span class="rate<%= averagetext %>"></span>&emsp;
              <span class="ratestr">
                <%= review.length %>レビュー
              </span>
            </div>
          </li>
          <form id="cartForm" name="cartForm" action="/my/cart" method="post">
            <input type="hidden" name="variantid" value="<%= myVariants[0].id %>">
            <% if (myVariants.length == 1) { %>
            <li class="detail-list-price">
              <div class="price txt-purple noto-sans">
                <%= myVariants[0].price.toLocaleString() %>円<span class="headline-small">&thinsp;(税込)</span>
              </div>
            </li>
            <% } else { %>
            <li class="detail-list-price">
              <% if (myVariants) { %>
                <% myVariants.forEach(function(variant) { %>
                <label>
                  <div class="price txt-purple noto-sans">
                  <% if (variant.variantname != "Default Title") { %>
                    <input type="radio" name="variantids" value="<%= variant.id %>">
                    <span class="variantname"><%= variant.variantname %></span>
                  <% } else { %>
                    <span class="variantname"><%= myproduct.productname %></span>
                  <% } %>
                  <%= variant.price.toLocaleString() %>円<span class="price-small">&thinsp;(税込)</span>&emsp;<span class="price-small"><%= variant.stock %>個</span>
                  </div>
                </label>
                <% }) %>
              <% } %>
            </li>
            <% } %>
            <li class="detail-list-content">
              <p>※配送料は購入手続き時に計算されます。</p>
              <p>商品番号:&nbsp;<%= myproduct.padid %>
              </p>
            </li>
            <hr>
            <li class="detail-number-area">
              <div class="minusbutton"><i class="fa-solid fa-minus"></i></div>
              <input class="productid" type="hidden" name="pid" value="<%= myproduct.id %>">
              <input id="numarea" class="numarea" type="number" name="num" value="1" min="1">
              <div class="plusbutton"><i class="fa-solid fa-plus"></i></div>
              <div class="favbutton">
                <i class="hearton heartbutton fa-solid fa-heart display-none" value="">
                  <span>
                    <%= myproduct.id %>
                  </span>
                </i>
                <i class="heartoff heartbutton fa-regular fa-heart" value="">
                  <span>
                    <%= myproduct.id %>
                  </span>
                </i>
              </div>
            </li>
            <li class="detail-list-printing">
              <% if (myproduct.bottleprinting==1) { %>
              <h4>ボトル名入れ</h4>
              <textarea id="bottleprinting" class="textarea" rows="1" name="bottleprinting" value="" placeholder="ボトルの名入れ文字を入れてください"></textarea>
              <label class="selectbox1">
                <span><b>フォント</b></span>
                <select id="bottlefont" name="bottlefont" >
                  <option value="">--選択してください--</option>
                  <option value="1">筆記体①(英数字のみ)</option>
                  <option value="2">筆記体②(英数字のみ)</option>
                  <option value="3">筆記体③(英数字のみ)</option>
                  <option value="4">ゴシック</option>
                  <option value="5">丸ゴシック</option>
                  <option value="6">筆文字①</option>
                  <option value="7">筆文字②</option>
                  <option value="8">明朝</option>
                </select>
              </label>
              <% } %>
              <% if (myproduct.glassprinting==1) { %>
              <h4>グラス名入れ</h4>
              <textarea id="glassprinting" class="textarea" rows="1" name="glassprinting" value="" placeholder="グラスの名入れ文字を入れてください"></textarea>
              <label class="selectbox2">
                <span><b>フォント</b></span>
                <select id="glassfont" name="glassfont" >
                  <option value="">--選択してください--</option>
                  <option value="1">筆記体①(英数字のみ)</option>
                  <option value="2">筆記体②(英数字のみ)</option>
                  <option value="3">筆記体③(英数字のみ)</option>
                  <option value="4">ゴシック</option>
                  <option value="5">丸ゴシック</option>
                  <option value="6">筆文字①</option>
                  <option value="7">筆文字②</option>
                  <option value="8">明朝</option>
                </select>
              </label>
              <% } %>
            </li>
            <li class="detail-list-buttons">
              <div class="btn">
                <button class="btn-cart">
                  <i class="fa-solid fa-cart-shopping"></i>&ensp;<input class="btn-red" type="submit"
                    value="カートに入れる">
                </button>
              </div>
            </li>
          </form>
        </ul>
        <hr>
      </div>
    </div>
    
    <div class="information-area">
      <%- myproduct.detailhtml %>
    </div>

    <div class="review-main-wrapper">
      <hr>
      <h2 class="review-list-title">カスタマーレビュー</h2>
      <div class="review-main-child">
        <% if (average !="0.0" ) { %>
        <div class="review-point">
          <ul class="review-point-flex">
            <li class="review-list-head">
              <div class="ratebox">
                <span class="rate<%= averagetext %>"></span>&emsp;5点満点中<%= average %>点
              </div>
            </li>
            <li class="review-list-head">
              <div class="head">
                <%= review.length %>件のレビューに基づいています
              </div>
            </li>
          </ul>
        </div>
        <div class="review-stars">
          <canvas id="myChart"></canvas>
        </div>
        <% } %>
        <div class="review-stars-button">
          <button id="review-button">
            <i class="fa-solid fa-pencil"></i>&emsp;<span class="review-str">レビューを書く</span>
          </button>
        </div>
      </div>
      <div class="review-list-newest">
        <% if (average !="0.0" ) { %>
        <details>
          <summary>
            さらに表示<span class="ico"></span>
          </summary>
          <% for ( let i=0; i < review.length; i++ ) { %>
          <div class="inner">
            <ul class="review-point-flex">
              <li class="list-review">
                <div class="ratebox"><span class="rate<%= review[i].stars %>"></span></div>
              </li>
              <li class="list-profile">
                <div class="usericon"><i class="fa-solid fa-user"></i></div>
                <div class="username">
                  <%= review[i].reviewername %>
                </div>
              </li>
              <li class="list-content">
                <%= review[i].content %>
              </li>
              <li class="list-date">
                <%= review[i].updated_at %>
              </li>
            </ul>
          </div>
          <% } %>
        </details>
        <% } %>
      </div>
      <hr>
    </div>

    <div class="wrap main-recommend-wrapper">
      <h3 class="detail-standard libre-baskerville">
        <span class="detail-small noto-sans">おすすめ</span>
      </h3>
      <div class="product-row-wrapper">
        <div id="recommendarea" class="product-row-parent">
          <% if (typeof recommend !="string" ) { %>
          <% recommend.forEach(function(rec) { %>
          <div class="product-row-child">
            <ul class="product-flex">
              <li class="list-image">
                <div class="favbutton">
                  <i class="hearton heartbutton fa-solid fa-heart display-none" value=""><span>
                    <%= rec.id %>
                  </span></i>
                  <i class="heartoff heartbutton fa-regular fa-heart" value=""><span>
                    <%= rec.id %>
                  </span></i>
                </div>
                <a href="/product/<%= rec.id %>">
                  <img class="recommend1" src="<%= rec.imagepath1 %>" alt="<%= rec.productname %>" onerror="this.onerror = null; this.src='';">
                </a>
              </li>
              <li class="list-category">
                <%= rec.categoryname %>
              </li>
              <li class="list-title">
                <%= rec.productname %>
              </li>
              <li class="three-trimming list-content">
                <%= rec.description %>
              </li>
            </ul>
          </div>
          <% }) %>
          <% } %>
        </div>
      </div>
    </div>
    
    <div id="reviewbox" class="forpc" style="display:none;">
      <form id="revierFormbox" name="cartForm" action="/my/review" method="post">
        <input type="hidden" class="pid" name="pid" value="<%= myproduct.id %>">
        <table cellpadding="2" cellspacing="10">
          <tr>
            <td class="table-header">
              お名前
            </td>
            <td class="table-body">
              <input type="text" name="reviewername" id="reviewername">
            </td>
          </tr>
          <tr>
            <td class="header">
              レビュー
            </td>
            <td>
              <div class="star-rating">
                <input type="radio" name="rating" value="1" id="star1">
                <label for="star1" data-label-num="1"></label>
                <input type="radio" name="rating" value="2" id="star2">
                <label for="star2" data-label-num="2"></label>
                <input type="radio" name="rating" value="3" id="star3">
                <label for="star3" data-label-num="3"></label>
                <input type="radio" name="rating" value="4" id="star4">
                <label for="star4" data-label-num="4"></label>
                <input type="radio" name="rating" value="5" id="star5">
                <label for="star5" data-label-num="5"></label>
              </div>
            </td>
          </tr>
          <tr>
            <td class="header">
              コメント
            </td>
            <td>
              <textarea class="textarea" rows="5" cols="40" name="comment" id="comment"></textarea>
            </td>
          </tr>
          <tr>
            <td colspan="2">
              <button type="submit" class="button-g button-9 button-standard">送信する</button>
            </td>
          </tr>
        </table>
      </form>
    </div>
  </main>
  <script src="/js/star.js"></script>
  <script src="/js/child.js"></script>
  <script>makeChartJs("<%= stars %>");</script>
  <%- include("./partials/footer.ejs") %>
</body>
</html>