<!DOCTYPE html>
<html lang="ja">

<head>
  <%- include('./partials/manage_head.ejs') %>
  <link rel="stylesheet" href="/css/newsregmanage.css">
  <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.2/themes/base/jquery-ui.css">
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://code.jquery.com/ui/1.14.2/jquery-ui.min.js"></script>
  <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1/i18n/jquery.ui.datepicker-ja.min.js"></script>
  <script>
    $(function() {
      $("#date").datepicker({
        changeMonth: true,
        changeYear: true
      });
    });
  </script>
</head>

<body>
  <header>
    <h2><%= title %></h2>
    <a href="javascript:history.back();">前の画面へ戻る</a>
  </header>
  <main>
    <table id="newsreg">
      <thead>
        <tr>
          <th>項目</th>
          <th colspan="2">入力</th>
        </tr>
      </thead>

      <form action="/registnews" id="regform" method="post" enctype="multipart/form-data">
        <tbody>
          <tr>
            <td>
              ID
            </td>
            <td colspan="2">
              自動発番
            </td>
          </tr>
          <tr>
            <td>
              日付
            </td>
            <td colspan="2">
              <input type="text" id="date" class="standard" name="date" value="">
            </td>
          </tr>
          <tr>
            <td>
              記事タイトル
            </td>
            <td colspan="2">
              <input type="text" class="standard" name="title" value="">
            </td>
          </tr>
          <tr>
            <td>
              記事内容
            </td>
            <td colspan="2">
              <textarea class="textarea" rows="5" cols="50" name="context" value=""></textarea>
            </td>
          </tr>
          <tr>
            <td>画像</td>
            <td>
             <input type="text" class="default" maxlength="255" name="imagename" value="">
            </td>
            <td>
              <input type="file" class="" name="file">
            </td>
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3">
              <button class="subbutton button-g button-6 button-wide" type="submit">新規登録</button>
            </td>
          </tr>
          <tr>
            <td colspan="3">
              <a href="javascript:history.back();">戻る</a>
            </td>
          </tr>
        </tfoot>
      </form>
    </table>
  </main>
  <%- include('./partials/manage_footer.ejs') %>
</body>
</html>